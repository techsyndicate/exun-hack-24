<%- layout('layout') %>

<h1 class="text-center text-[8vh] font-extrabold mt-[5vh] mb-[5vh]">Users</h1>

<div class="objects w-[100%] flex flex-row flex-wrap justify-center items-center gap-[2vw] mb-[6vh]">    
    <% for( let i = 0; i < users.length; i++ ) { %>
        <div class="object w-1/5">
            <div class="bg-periwinkle p-6 rounded-xl flex flex-col justify-center items-center">
                <% if (users[i].avatar) { %>
                    <img
                        onclick="showModal()"
                        src="<%= users[i].avatar %>"
                        alt="Profile"
                        class="w-[10vw] object-cover rounded-full mb-6 aspect-square"
                    />
                    <% } else { %>
                    <img
                        onclick="showModal()"
                        src="/avatar.png"
                        alt="Profile"
                        class="w-[10vw] rounded-full object-cover mb-6 aspect-square"
                    />
                    <% } %>
                <h2 class="text-3xl text-primary font-bold mb-1"><%= users[i].fname + ' ' + users[i].lname%></h2>
                <p class="text-primary text-xl">Role : &nbsp;<%= users[i].role%></p>
                <button type="button" class="bg-accent-light p-[1vw] w-[100%] mt-[2vh] text-2xl rounded-md" onclick="window.location.href='/nerit/profile/<%= users[i]._id%>'">View Profile</button>
            </div>
        </div>
    <% } %>

</div>